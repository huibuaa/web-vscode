{
  "name": "web-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "hui",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./resources/l10n",
  "contributes": {
    "configuration": {
      "title": "Web-VSCode",
      "properties": {
        "web-vscode.apiUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "%config.web-vscode.apiUrl.description%",
          "order": 1
        },
        "web-vscode.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.web-vscode.apiKey.description%",
          "order": 2,
          "sensitive": true
        },
        "web-vscode.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "%config.web-vscode.model.description%",
          "order": 3
        },
        "web-vscode.autoTriggerCompletion": {
          "type": "boolean",
          "default": true,
          "description": "%config.web-vscode.autoTriggerCompletion.description%",
          "order": 4
        },
        "web-vscode.completionMaxTokens": {
          "type": "number",
          "default": 256,
          "description": "%config.web-vscode.completionMaxTokens.description%",
          "order": 5
        }
      }
    },
    "commands": [
      {
        "command": "web-vscode.chat.focus",
        "title": "%command.web-vscode.chat.focus.title%",
        "category": "Web-VSCode"
      },
      {
        "command": "web-vscode.explain",
        "title": "%command.web-vscode.explain.title%",
        "category": "Web-VSCode"
      },
      {
        "command": "web-vscode.unit-test",
        "title": "%command.web-vscode.unit-test.title%",
        "category": "Web-VSCode"
      },
      {
        "command": "web-vscode.fix-bugs",
        "title": "%command.web-vscode.fix-bugs.title%",
        "category": "Web-VSCode"
      },
      {
        "command": "web-vscode.use-case",
        "title": "%command.web-vscode.use-case.title%",
        "category": "Web-VSCode"
      },
      {
        "command": "web-vscode.generate-comment",
        "title": "%command.web-vscode.generate-comment.title%",
        "category": "Web-VSCode"
      }
    ],
    "submenus": [
      {
        "id": "web_vscode_context_menu",
        "label": "%submenu.web_vscode_context_menu.label%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "web_vscode_context_menu",
          "group": "navigation"
        }
      ],
      "web_vscode_context_menu": [
        {
          "command": "web-vscode.chat.focus",
          "group": "actions@0"
        },
        {
          "command": "web-vscode.explain",
          "when": "editorHasSelection",
          "group": "actions@1"
        },
        {
          "command": "web-vscode.use-case",
          "when": "editorHasSelection",
          "group": "actions@2"
        },
        {
          "command": "web-vscode.generate-comment",
          "when": "editorHasSelection",
          "group": "actions@3"
        },
        {
          "command": "web-vscode.unit-test",
          "when": "editorHasSelection",
          "group": "actions@4"
        },
        {
          "command": "web-vscode.fix-bugs",
          "when": "editorHasSelection",
          "group": "actions@5"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "web-vscode-sidebar",
          "title": "%views.web-vscode-sidebar.title%",
          "icon": "resources/assets/images/icon.svg" 
        }
      ]
    },
    "views": {
      "web-vscode-sidebar": [
        {
          "id": "web-vscode.chatView",
          "name": "%views.web-vscode.chatView.name%",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
